# Local dev — SQLite (no setup needed)
DATABASE_URL=sqlite:///./scout.db

# Production — swap for Supabase connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname

GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# CORS — comma-separated frontend origins
ALLOWED_ORIGINS=https://alexdaucourt.dev,https://www.alexdaucourt.dev,http://localhost:5173,http://127.0.0.1:5173

# Auth — set a secret key; leave unset to disable auth in local dev
# SCOUT_API_KEY=your_secret_here

# Club configuration — set to any Big 5 club
CLUB_NAME=Paris S-G
CLUB_LEAGUE=Ligue 1
